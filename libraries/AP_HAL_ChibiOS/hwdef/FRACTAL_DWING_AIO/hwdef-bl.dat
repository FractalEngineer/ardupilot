# hw definition file for the Fractal D-Wing AIO bootloader

MCU STM32H7xx STM32H743xx

APJ_BOARD_ID AP_HW_FRACTAL_DWING_AIO

OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048

# The bootloader occupies the first 128 KiB.
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PE3 LED_BOOTLOADER OUTPUT LOW GPIO(90)
PE4 LED_ACTIVITY   OUTPUT LOW GPIO(91)
define HAL_LED_ON 0

SERIAL_ORDER OTG1 USART1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# USART1 for firmware upload
PB14 USART1_TX USART1 NODMA
PB15 USART1_RX USART1 NODMA

# Keep SPI chip selects inactive and switched peripherals at their safe
# startup levels while the main firmware is not running.
PD4  MPU_CS  CS
PC14 MPU2_CS CS
PB1  PINIO1  OUTPUT GPIO(81) LOW
PD10 CAM_SW  OUTPUT GPIO(82) LOW
PE9  VTX_PWR OUTPUT GPIO(83) HIGH
