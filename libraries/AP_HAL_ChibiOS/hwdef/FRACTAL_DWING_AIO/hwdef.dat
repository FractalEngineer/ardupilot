# hw definition file for the Fractal D-Wing AIO
# Pin assignments derived from the FRENH7WINGAIO Betaflight target.

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_FRACTAL_DWING_AIO

OSCILLATOR_HZ 8000000

define STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# ArduPilot bootloader, OSD ROMFS and parameter storage
FLASH_RESERVE_START_KB 128
FLASH_SIZE_KB 2048
MCU_CLOCKRATE_MHZ 480
STORAGE_FLASH_PAGE 14
define HAL_STORAGE_SIZE 32768

I2C_ORDER I2C1 I2C2

# USB, UART1/UART2/UART3/UART5/UART6/UART8
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART5 USART6 UART8

# LEDs
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PE3 LED_BLUE  OUTPUT LOW GPIO(90)
PE4 LED_GREEN OUTPUT LOW GPIO(91)
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90

# BEEPER_INVERTED in the Betaflight target
PC13 BUZZER OUTPUT GPIO(32) LOW
define HAL_BUZZER_PIN 32

# SPI1: ICM42605 IMU
PA5 SPI1_SCK SPI1
PB4 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1
PD4 MPU_CS CS
PC15 GYRO_EXTI INPUT

# SPI2: LSM6DSV16X IMU
PD3 SPI2_SCK SPI2
PC2 SPI2_MISO SPI2
PC3 SPI2_MOSI SPI2
PC14 MPU2_CS CS
PB0 GYRO2_EXTI INPUT

# I2C1 is the external compass bus. I2C2 connects the onboard BMP388.
PB8  I2C1_SCL I2C1
PB9  I2C1_SDA I2C1
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2
define HAL_I2C_INTERNAL_MASK 2

# Battery, current and RSSI analog inputs.
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)
PA7 RSSI_ADC_PIN      ADC1 SCALE(1)
define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_CURR_PIN 11
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 40.0
define BOARD_RSSI_ANA_PIN 7

# USART1: user port
PB14 USART1_TX USART1
PB15 USART1_RX USART1

# USART2: SmartAudio (single-wire TX)
PA2 USART2_TX USART2
PA3 USART2_RX USART2
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_SmartAudio

# USART3: GPS
PD8 USART3_TX USART3
PD9 USART3_RX USART3
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_GPS

# UART5: user port
PC12 UART5_TX UART5
PD2  UART5_RX UART5

# USART6: CRSF receiver
PC6 USART6_TX USART6
PC7 USART6_RX USART6
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_RCIN

# UART8: MSP DisplayPort OSD
PE1 UART8_TX UART8
PE0 UART8_RX UART8
define DEFAULT_SERIAL6_PROTOCOL SerialProtocol_MSP_DisplayPort

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# Outputs follow the Betaflight MOTOR1, MOTOR2, SERVO1-8 then LED strip
# ordering.
PA8  TIM1_CH1 TIM1 PWM(1)  GPIO(50)
PA9  TIM1_CH2 TIM1 PWM(2)  GPIO(51)
PA15 TIM2_CH1 TIM2 PWM(3)  GPIO(52)
PA1  TIM2_CH2 TIM2 PWM(4)  GPIO(53)
PA6  TIM3_CH1 TIM3 PWM(5)  GPIO(54)
PB5  TIM3_CH2 TIM3 PWM(6)  GPIO(55)
PC8  TIM3_CH3 TIM3 PWM(7)  GPIO(56)
PC9  TIM3_CH4 TIM3 PWM(8)  GPIO(57)
PD12 TIM4_CH1 TIM4 PWM(9)  GPIO(58)
PB7  TIM4_CH2 TIM4 PWM(10) GPIO(59)
PA0  TIM5_CH1 TIM5 PWM(11) GPIO(60) # WS2812 LED strip

# User-controlled power and camera switches. VTX_PWR starts high, matching
# the inverted PINIO3 configuration in the Betaflight target. Map these to
# relays so users only need to assign the appropriate RCx_OPTION.
PB1  PINIO1  OUTPUT GPIO(81) LOW
PD10 CAM_SW  OUTPUT GPIO(82) LOW
PE9  VTX_PWR OUTPUT GPIO(83) HIGH
define RELAY1_PIN_DEFAULT 81
define RELAY1_DEFAULT 0
define RELAY2_PIN_DEFAULT 82
define RELAY2_DEFAULT 0
define RELAY3_PIN_DEFAULT 83
define RELAY3_DEFAULT 1

DMA_PRIORITY SPI1* SPI2*
DMA_NOSHARE SPI1* SPI2* TIM2* TIM3* TIM4* TIM5*

# QUADSPI for the MT29F NAND flash. Dataflash support is pending upstream
# PR #32146, so this is not currently used.
PB2  QUADSPI_CLK     QUADSPI1 SPEED_HIGH
PB6  QUADSPI_BK1_NCS QUADSPI1 SPEED_HIGH
PD11 QUADSPI_BK1_IO0 QUADSPI1 SPEED_HIGH
PC10 QUADSPI_BK1_IO1 QUADSPI1 SPEED_HIGH
PE2  QUADSPI_BK1_IO2 QUADSPI1 SPEED_HIGH
PD13 QUADSPI_BK1_IO3 QUADSPI1 SPEED_HIGH

SPIDEV icm42605 SPI1 DEVID1 MPU_CS  MODE3 2*MHZ 24*MHZ
SPIDEV lsm6dsv  SPI2 DEVID1 MPU2_CS MODE3 2*MHZ 24*MHZ

# 2 IMUs
IMU Invensensev3 SPI:icm42605 ROTATION_ROLL_180_YAW_270
IMU LSM6DSV      SPI:lsm6dsv   ROTATION_PITCH_180
define HAL_DEFAULT_INS_FAST_SAMPLE 3

# BMP388 on I2C2
BARO BMP388 I2C:1:0x76

# Probe all supported external compass types on I2C1.
define AP_COMPASS_PROBING_ENABLED 1
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# setup for OSD (MSP DisplayPort)
define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 5
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin
define DEFAULT_NTF_LED_TYPES 455

AUTOBUILD_TARGETS Plane
